{
  "name": "@alexey_demin/dsh-balance-window",
  "version": "0.1.2",
  "description": "A fixed DeepSeek Harness sidebar chip with your DeepSeek balance and the estimated cost of the last turn, plus a hover breakdown.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "balance",
    "usage",
    "cost",
    "sidebar"
  ],
  "homepage": "https://github.com/AlexeyDemin0/dsh-balance-window#readme",
  "bugs": {
    "url": "https://github.com/AlexeyDemin0/dsh-balance-window/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexeyDemin0/dsh-balance-window.git"
  },
  "license": "MIT",
  "author": "Alexey Demin <AlexeyDeminA@gmail.com>",
  "type": "module",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "scripts/check-client-id.mjs",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "check": "node --check host.js && node --check client.js && node scripts/check-client-id.mjs",
    "test": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "icon": "./icon.svg",
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
